generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alumno {
  id                  String    @id @default(cuid())
  nombre              String
  edad                Int
  telefono            String?
  tipoPago            String    // "diario", "semanal", "mensual"
  montoPago           Decimal   @db.Decimal(10, 2)
  pagaTransporte      Boolean   @default(false)
  montoTransporte     Decimal?  @db.Decimal(10, 2)
  transporteAsignado  String?
  pagaOtrosPagos      Boolean   @default(false)
  otrosPagos          Decimal?  @db.Decimal(10, 2)
  fechaRegistro       DateTime
  estado              String    @default("Activo")
  notasInactividad    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  pagos               Pago[]

  @@map("alumnos")
}

model Pago {
  id                String   @id @default(cuid())
  alumnoId          String
  alumno            Alumno   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  concepto          String   // "clase", "transporte", "otros"
  monto             Decimal  @db.Decimal(10, 2)
  fechaVencimiento  DateTime
  pagado            Boolean  @default(false)
  fechaPago         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("pagos")
}
