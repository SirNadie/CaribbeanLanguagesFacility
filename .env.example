# ===========================================
# Caribbean Language Facility - Environment Variables
# ===========================================

# Database Connection (Required)
# Get this from your Neon PostgreSQL dashboard
DATABASE_URL="postgresql://username:password@hostname:5432/database?sslmode=require"

# Make.com Webhook URL for contact form submissions
# Get this from your Make.com account (Webhooks -> HTTP Webhook)
NEXT_PUBLIC_MAKE_WEBHOOK_URL=https://hook.us2.make.com/your-webhook-id

# ===========================================
# Optional: Analytics
# ===========================================
# NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXXXXXX-X
